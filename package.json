{
  "name": "manifest-lens",
  "displayName": "Manifest Lens",
  "version": "0.1.0",
  "description": "Understand, maintain and safely upgrade dependencies from your manifests: updates, peer dependency conflicts, OSV advisories and a dependency dashboard.",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "bun",
    "catalog",
    "codelens",
    "dependencies",
    "npm",
    "outdated",
    "package.json",
    "peer dependencies",
    "pnpm",
    "semver",
    "updates",
    "upgrade",
    "version",
    "vulnerabilities",
    "workspace"
  ],
  "homepage": "https://github.com/demartini/vscode-manifest-lens#readme",
  "bugs": {
    "url": "https://github.com/demartini/vscode-manifest-lens/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/demartini/vscode-manifest-lens.git"
  },
  "qna": "marketplace",
  "publisher": "demartini",
  "scripts": {
    "check": "ultracite check",
    "check-types": "tsc --noEmit",
    "clean": "git clean -xdf .vscode-test coverage dist out node_modules",
    "compile": "tsdown",
    "compile-tests": "tsc -p tsconfig.json",
    "fix": "ultracite fix",
    "test:unit": "bun run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "vscode:prepublish": "bun run compile -- --minify",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.3"
}
